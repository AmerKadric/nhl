{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "puckiq-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "puckiq.cli", "serve", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "puckiq-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
