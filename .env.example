# --- engine / API ---
# SQLite by default (data/puckiq.db). Use PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@host:5432/puckiq
PUCKIQ_CORS_ORIGINS=http://localhost:3000
PUCKIQ_RATE_LIMIT_PER_MIN=240
PUCKIQ_LAB_RATE_LIMIT_PER_MIN=40
PUCKIQ_LOG_JSON=0

# --- web (web/.env.local) ---
PUCKIQ_API_URL=http://127.0.0.1:8000
